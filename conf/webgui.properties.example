# CM Migrator WebGUI authentication template
# Copy to conf/webgui.properties and keep the resulting file untracked.

webgui.auth.enabled=true
webgui.admin.user=admin

# Preferred: provide the plaintext password only to the WebGUI process.
# Example without placing the value in this file or in command history:
#   read -rsp 'WebGUI password: ' WEBGUI_ADMIN_PASSWORD; echo
#   export WEBGUI_ADMIN_PASSWORD

# Legacy alternative: a 64-character hexadecimal SHA-256 password hash.
# SHA-256 here is unsalted legacy compatibility, not a modern password KDF.
# webgui.admin.password.hash=

# With authentication enabled, startup fails unless the user and either the
# environment password/property password or a valid hash are configured.
# No password is generated, logged, or used to silently disable authentication.
