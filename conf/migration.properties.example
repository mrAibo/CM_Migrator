# CM Migrator configuration template
# Copy to conf/migration.properties, keep it untracked, set chmod 600, and
# replace every required blank field before use. Never commit credentials.

# Connection profile and endpoints
PROFILE=KLEIN
SOURCE_SSID=
DEST_SSID=
SOURCE_USER=
SOURCE_PASSWORD_CRYPT=
DEST_USER=
DEST_PASSWORD_CRYPT=
# Optional shared fallback instead of separate source/destination credentials:
CONNECT_USER=
CONNECT_PASSWORD_CRYPT=

# Operation. Supported values: MIGRATE, DELETE
OPERATION_MODE=MIGRATE
# Comma-separated SOURCE_TYPE:DEST_TYPE mappings. Configure explicitly.
MIGRATE_ITEMTYPES=
FILTER_PREDICATE=
DRY_RUN=false

# Concurrency and queueing
THREAD_COUNT=5
BATCH_SIZE=100
QUEUE_SIZE=10000
PRODUCER_COUNT_STRATEGY=HYBRID
CONSUMER_DOUBLECHECK=false
SOURCE_POOL_SIZE=6
DEST_POOL_SIZE=5
POOL_BORROW_TIMEOUT=5000
POOL_MAX_WAIT_TIME=10000

# Journal and logging
DB_PATH=./data/migration_journal
DATA_DIR=./data
DB_URL_APPEND=
LOG_ITEMS_BATCHED=false
LOG_BATCH_INTERVAL=10000
LOG_ERRORS_IMMEDIATE=true

# Content transfer
STREAM_UPLOAD=false

# Reports and notifications
GENERATE_AUDIT_PROTOCOL=true
AUDIT_PROTOCOL_OUTPUT_DIR=./reports
PROTOCOL_OUTPUT_DIR=./reports
PROTOCOL_COMPANY_NAME=
PROTOCOL_COMPANY_LOGO=
EMAIL_TO=
AUTO_MARK_FOR_REMIGRATION=true

# Destructive verification remains blocked by the launcher guard until explicit
# IBM live approval, even though Java now distinguishes EXISTS/NOT_FOUND/ERROR.
CASCADE_DELETE_ON_MISSING=false

# WebGUI authentication fallback. conf/webgui.properties takes precedence.
# With authentication enabled, startup fails unless a non-empty admin user and
# either WEBGUI_ADMIN_PASSWORD or a valid SHA-256 hash are configured.
webgui.auth.enabled=true
webgui.admin.user=admin
# webgui.admin.password.hash=
WEBGUI_ALLOW_PASSWORDLESS_CM_LOGIN=false
