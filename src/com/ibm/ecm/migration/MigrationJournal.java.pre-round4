/*
 * Projekt: CM Migrator 2.2.1.
 * @Author: Aleksej Voronin, Sven Lindt
 * @Date:   26.01.2026
 * 
 * Verarbeitet die Interaktion mit mehreren H2-Journal-Datenbanken (eine pro ItemType).
 * Gewährleistet Idempotenz und speichert SHA-256-Prüfsummen.
 */
package com.ibm.ecm.migration;

import java.io.File;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.concurrent.*;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.concurrent.atomic.AtomicLong;
import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.h2.jdbcx.JdbcConnectionPool;

public class MigrationJournal implements AutoCloseable {
    private static final Logger logger = LogManager.getLogger(MigrationJournal.class);
    
    // Map ItemType -> Connection Pool
    private final Map<String, JdbcConnectionPool> connectionPools = new ConcurrentHashMap<>();
    
    // Begrenzter LRU-Cache mit konfigurierbarer maximaler Größe
    // Standard: 5 Millionen Einträge (~250 MB bei 50 Byte/Eintrag)
    // Bei 500 Millionen Elementen: Nur die zuletzt aufgerufenen Elemente im Speicher behalten
    private static final int DEFAULT_MAX_CACHE_SIZE = 5_000_000;
    private final int maxCacheSize;
    private final Map<String, String> statusCache;
    
    // Cache Statistik für monitoring
    private final AtomicLong cacheHits = new AtomicLong(0);
    private final AtomicLong cacheMisses = new AtomicLong(0);
    private final AtomicLong cacheEvictions = new AtomicLong(0);
    
    private final String baseDir;
    private final String dbUrlAppend;

    // Async Journaling
    private final BlockingQueue<JournalEntry> journalQueue = new LinkedBlockingQueue<>(100000);
    private final AtomicBoolean running = new AtomicBoolean(false);
    private Thread writerThread;

    private static class JournalEntry {
        final String itemId;
        final String itemType;
        final String status;
        final String checksum;
        final String destItemId;
        final String message;

        JournalEntry(String itemId, String itemType, String status, String checksum, String destItemId, String message) {
            this.itemId = itemId;
            this.itemType = itemType;
            this.status = status;
            this.checksum = checksum;
            this.destItemId = destItemId;
            this.message = message;
        }
    }

    public MigrationJournal(String baseDir) {
        this(baseDir, "", DEFAULT_MAX_CACHE_SIZE);
    }

    public MigrationJournal(String baseDir, String dbUrlAppend) {
        this(baseDir, dbUrlAppend, DEFAULT_MAX_CACHE_SIZE);
    }

    /**
     * Konstruktor mit konfigurierbarer Cache-Größe.
     * @param baseDir Verzeichnis für H2-Datenbankdateien
     * @param dbUrlAppend JDBC URL Parameter
     * @param maxCacheSize Max. number of entries in the LRU cache
     */
    public MigrationJournal(String baseDir, String dbUrlAppend, int maxCacheSize) {
        this.baseDir = baseDir;
        this.dbUrlAppend = dbUrlAppend != null ? dbUrlAppend : "";
        this.maxCacheSize = maxCacheSize > 0 ? maxCacheSize : DEFAULT_MAX_CACHE_SIZE;
        
        final int finalMaxSize = this.maxCacheSize;
        final AtomicLong evictionCounter = this.cacheEvictions;
        
        this.statusCache = java.util.Collections.synchronizedMap(
            new LinkedHashMap<String, String>(16, 0.75f, true) {
                @Override
                protected boolean removeEldestEntry(Map.Entry<String, String> eldest) {
                    boolean shouldRemove = size() > finalMaxSize;
                    if (shouldRemove) {
                        evictionCounter.incrementAndGet();
                    }
                    return shouldRemove;
                }
            }
        );
        
        logger.info("MigrationJournal created with LRU cache (maxSize={})", this.maxCacheSize);
    }

    public void init() throws SQLException {
        try {
            Class.forName("org.h2.Driver");
            new File(baseDir).mkdirs();
            
            // v1.30: Start Journal Writer Thread
            running.set(true);
            writerThread = new Thread(this::writerLoop, "JournalWriter");
            writerThread.setDaemon(true);
            writerThread.start();
            
            logger.info("Journal initialized. Base directory: " + baseDir + " (Async Writer active)");
        } catch (ClassNotFoundException e) {
            throw new SQLException("H2 Driver not found", e);
        }
    }

    // Uses Double-Checked Locking to create the pool
    private Connection getConnection(String itemType) throws SQLException {
        JdbcConnectionPool pool = connectionPools.get(itemType);
        if (pool == null) {
            synchronized (connectionPools) {
                pool = connectionPools.get(itemType);
                if (pool == null) {
                    String dbPath = baseDir + "/journal_" + itemType;
                    String jdbcUrl = "jdbc:h2:" + dbPath + dbUrlAppend;
                    
                    logger.info("Creating Journal Connection Pool for " + itemType + ": " + jdbcUrl);
                    pool = JdbcConnectionPool.create(jdbcUrl, "sa", "");
                    pool.setMaxConnections(100); // v1.28: Increased for high-concurrency enterprise scaling
                    
                    // Initialize Table using a temporary connection from the new pool
                    try (Connection conn = pool.getConnection()) {
                        createTable(conn);
                    }
                    
                    connectionPools.put(itemType, pool);
                }
            }
        }
        return pool.getConnection(); // Gibt eine Verbindung zurück, an den Pool zurückgegeben werden muss
    }

    private void createTable(Connection conn) throws SQLException {
        String sql = "CREATE TABLE IF NOT EXISTS AUDIT_LOG (" +
                     "ITEM_ID VARCHAR(255) PRIMARY KEY, " +
                     "DEST_ITEM_ID VARCHAR(255), " +
                     "ITEM_TYPE VARCHAR(100), " +
                     "STATUS VARCHAR(20), " +
                     "CHECKSUM VARCHAR(64), " +
                     "MESSAGE VARCHAR(4000), " +
                     "MIGRATION_TIME TIMESTAMP DEFAULT CURRENT_TIMESTAMP" +
                     ")";
        try (Statement stmt = conn.createStatement()) {
            stmt.execute(sql);
            stmt.execute("CREATE INDEX IF NOT EXISTS IDX_STATUS ON AUDIT_LOG(STATUS)");
        }
    }

    public boolean isMigrated(String itemId, String itemType) {
        String cacheKey = itemType + ":" + itemId;
        String cachedStatus = statusCache.get(cacheKey);
        if (cachedStatus != null) {
            return "SUCCESS".equalsIgnoreCase(cachedStatus);
        }
        
        // Fallback auf DB (langsamer) – Verwendet gepoolte Verbindung mit try-with-resources
        try (Connection conn = getConnection(itemType)) {
            String sql = "SELECT STATUS FROM AUDIT_LOG WHERE ITEM_ID = ?";
            try (PreparedStatement pstmt = conn.prepareStatement(sql)) {
                pstmt.setString(1, itemId);
                try (ResultSet rs = pstmt.executeQuery()) {
                    if (rs.next()) {
                        String status = rs.getString("STATUS");
                        statusCache.put(cacheKey, status); // Cache it
                        return "SUCCESS".equalsIgnoreCase(status);
                    }
                }
            }
        } catch (SQLException e) {
            logger.error("Error checking migration status for " + itemId, e);
        }
        return false;
    }

    public boolean isDeleted(String itemId, String itemType) {
        // Check cache FIRST
        String cacheKey = itemType + ":" + itemId;
        String cachedStatus = statusCache.get(cacheKey);
        if (cachedStatus != null) {
            return "DELETED".equalsIgnoreCase(cachedStatus);
        }
        
        // Fallback auf DB – Verwendet gepoolte Verbindung
        try (Connection conn = getConnection(itemType)) {
            String sql = "SELECT STATUS FROM AUDIT_LOG WHERE ITEM_ID = ?";
            try (PreparedStatement pstmt = conn.prepareStatement(sql)) {
                pstmt.setString(1, itemId);
                try (ResultSet rs = pstmt.executeQuery()) {
                    if (rs.next()) {
                        String status = rs.getString("STATUS");
                        statusCache.put(cacheKey, status); // Cache it
                        return "DELETED".equalsIgnoreCase(status);
                    }
                }
            }
        } catch (SQLException e) {
            logger.error("Error checking deletion status for " + itemId, e);
        }
        return false;
    }

    public void logBatchSuccess(java.util.List<MigrationItem> batch) {
        for (MigrationItem item : batch) {
            logSuccess(item.getItemId(), item.getSourceItemType(), item.getChecksum(), item.getDestItemId());
        }
    }

    public void logSuccess(String itemId, String itemType, String checksum, String destItemId) {
        upsertStatus(itemId, itemType, "SUCCESS", checksum, destItemId, "Migrated successfully");
    }

    public void logFailure(String itemId, String itemType, String errorMsg) {
        upsertStatus(itemId, itemType, "FAILED", null, null, errorMsg);
    }

    public void logSkipped(String itemId, String itemType, String reason) {
        upsertStatus(itemId, itemType, "SKIPPED", null, null, reason);
    }

    public void logDeletion(String itemId, String itemType, String message) {
        upsertStatus(itemId, itemType, "DELETED", null, null, message);
    }

    private void upsertStatus(String itemId, String itemType, String status, String checksum, String destItemId, String message) {
        String cacheKey = itemType + ":" + itemId;
        statusCache.put(cacheKey, status);

        // Offload to background writer
        if (!journalQueue.offer(new JournalEntry(itemId, itemType, status, checksum, destItemId, message))) {
            logger.warn("Journal queue full! Dropping status update for {}. (Check H2 load)", itemId);
        }
    }

    /**
     * Das Herzstück des asynchronen Journalings.
     * Leert die Warteschlange und fasst Schreibvorgänge nach ItemType zu Batches zusammen.
     */
    private void writerLoop() {
        java.util.List<JournalEntry> buffer = new java.util.ArrayList<>(1000);
        while (running.get() || !journalQueue.isEmpty()) {
            try {
                JournalEntry first = journalQueue.poll(500, TimeUnit.MILLISECONDS);
                if (first == null) continue;

                buffer.add(first);
                journalQueue.drainTo(buffer, 999);

                // Group by ItemType for batching
                Map<String, java.util.List<JournalEntry>> byType = new java.util.HashMap<>();
                for (JournalEntry entry : buffer) {
                    byType.computeIfAbsent(entry.itemType, k -> new java.util.ArrayList<>()).add(entry);
                }

                for (Map.Entry<String, java.util.List<JournalEntry>> group : byType.entrySet()) {
                    writeBatchToDb(group.getKey(), group.getValue());
                }

                buffer.clear();
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break;
            } catch (Exception e) {
                logger.error("Error in JournalWriter loop", e);
            }
        }
        logger.info("JournalWriter thread terminating.");
    }

    private void writeBatchToDb(String itemType, java.util.List<JournalEntry> entries) {
        try (Connection conn = getConnection(itemType)) {
            conn.setAutoCommit(false);
            String sql = "MERGE INTO AUDIT_LOG (ITEM_ID, ITEM_TYPE, STATUS, CHECKSUM, DEST_ITEM_ID, MESSAGE, MIGRATION_TIME) " +
                         "KEY(ITEM_ID) VALUES (?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)";
            
            try (PreparedStatement pstmt = conn.prepareStatement(sql)) {
                for (JournalEntry entry : entries) {
                    pstmt.setString(1, entry.itemId);
                    pstmt.setString(2, entry.itemType);
                    pstmt.setString(3, entry.status);
                    pstmt.setString(4, entry.checksum);
                    pstmt.setString(5, entry.destItemId);
                    String msg = entry.message;
                    if (msg != null && msg.length() > 4000) msg = msg.substring(0, 3997) + "...";
                    pstmt.setString(6, msg);
                    pstmt.addBatch();
                }
                pstmt.executeBatch();
                conn.commit();
            } catch (SQLException e) {
                conn.rollback();
                logger.error("Failed to write journal batch for " + itemType, e);
            }
        } catch (SQLException e) {
            logger.error("Could not get journal connection for " + itemType, e);
        }
    }

    /**
     * LEISTUNGSKRITISCH: Alle vorhandenen Einträge aus dem Journal in den Cache vorladen.
     * Dies zu Beginn der Migration EINMAL pro ItemType aufrufen, um DB-Abfragen zu vermeiden.
     * Nach dem Vorladen wird isMigrated() zu einer Cache-Abfrage.
     */
    public int preloadCache(String itemType) {
        int loaded = 0;
        try (Connection conn = getConnection(itemType)) {
            String sql = "SELECT ITEM_ID, STATUS FROM AUDIT_LOG";
            try (Statement stmt = conn.createStatement();
                 ResultSet rs = stmt.executeQuery(sql)) {
                while (rs.next()) {
                    String itemId = rs.getString("ITEM_ID");
                    String status = rs.getString("STATUS");
                    String cacheKey = itemType + ":" + itemId;
                    statusCache.put(cacheKey, status);
                    loaded++;
                }
            }
            logger.info("Preloaded {} entries into cache for ItemType: {}", loaded, itemType);
        } catch (SQLException e) {
            logger.error("Error preloading cache for " + itemType, e);
        }
        return loaded;
    }

    @Override
    public void close() {
        logger.info("Closing MigrationJournal. Draining queue ({} entries left)...", journalQueue.size());
        
        running.set(false);
        if (writerThread != null) {
            try {
                writerThread.join(30000);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }

        logger.info("Journal Writer stopped. Cache size: " + statusCache.size() + " entries");
        
        for (Map.Entry<String, JdbcConnectionPool> entry : connectionPools.entrySet()) {
            try {
                entry.getValue().dispose();
                logger.info("Disposed Journal Pool for " + entry.getKey());
            } catch (Exception e) {
                logger.error("Error disposing pool for " + entry.getKey(), e);
            }
        }
        connectionPools.clear();
        statusCache.clear();
    }

    /**
     * Robuste Tabellenpräsenzprüfung mithilfe von JDBC-Metadaten.
     */
    public static boolean isTablePresent(Connection conn, String tableName) {
        if (conn == null || tableName == null) return false;
        try {
            var dbMeta = conn.getMetaData();
            // Check sowohl große Buchstaben (Standard für DB2/H2) als auch alles, was übergeben wurde.
            try (var rs = dbMeta.getTables(null, null, tableName.toUpperCase(), null)) {
                if (rs.next()) return true;
            }
            try (var rs = dbMeta.getTables(null, null, tableName.toLowerCase(), null)) {
                if (rs.next()) return true;
            }
            return false;
        } catch (Exception e) {
            return false;
        }
    }
}
