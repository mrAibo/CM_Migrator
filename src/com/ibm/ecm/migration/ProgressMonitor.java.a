/*
 * Projekt: CM Migrator 2.2.1.
 * @Author: Aleksej Voronin, Sven Lindt
 * @Date:   26.01.2026
 * 
 * Gibt den Migrationsfortschritt auf der Konsole aus und generiert ein status.html-Dashboard.
 * Browser-Benutzeroberfläche: Von „Migration Control“ Dashboard (helles Design).
 */
package com.ibm.ecm.migration;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;

import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.nio.file.Files;
import java.time.Duration;
import java.time.Instant;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.concurrent.atomic.AtomicBoolean;

public class ProgressMonitor implements Runnable {
    private static final Logger logger = LogManager.getLogger(ProgressMonitor.class);

    private final MigrationStats stats;
    private final long updateInterval;
    private final String sourceSSID;
    private final String destSSID;
    private final String itemTypeMapping;
    private final String mode;
    private final Instant startTime;
    private final AtomicBoolean running = new AtomicBoolean(true);

    // Email & Report Config
    private final MigrationConfig config;

    private boolean headerPrinted = false;

    public ProgressMonitor(MigrationStats stats, long updateInterval, String sourceSSID, String destSSID, String itemTypeMapping, String mode, MigrationConfig config) {
        this.stats = stats;
        this.updateInterval = updateInterval;
        this.sourceSSID = sourceSSID;
        this.destSSID = destSSID;
        this.itemTypeMapping = itemTypeMapping;
        this.mode = mode;
        this.config = config; // Config speichern für Reports
        this.startTime = Instant.now();
    }

    // Konstruktor für Kompatibilität (falls Main.java noch den alten nutzt)
    public ProgressMonitor(MigrationStats stats, long updateInterval, String sourceSSID, String destSSID, String itemTypeMapping, String mode) {
        this(stats, updateInterval, sourceSSID, destSSID, itemTypeMapping, mode, null);
    }

    @Override
    public void run() {
        try { Thread.sleep(2000); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }

        printHeader();

        while (running.get()) {
            try {
                Thread.sleep(updateInterval);
                printProgress();
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break;
            }
        }
        printProgress();
        System.out.println(); // Neue Zeile am Ende
        
        // Report am Ende generieren
        if (config != null) {
            generateAndSendReport();
        }
    }

    private void printHeader() {
        if (headerPrinted) return;
        
        System.out.println();
        System.out.println(ConsoleUI.SEPARATOR);
        System.out.printf("📦 %s %s → %s%n", mode, sourceSSID, destSSID);
        System.out.println(ConsoleUI.SEPARATOR);
        if (itemTypeMapping != null && !itemTypeMapping.isEmpty()) {
            String displayMapping = itemTypeMapping.length() > 60 ? itemTypeMapping.substring(0, 57) + "..." : itemTypeMapping;
            System.out.printf("   Mapping: %s%n", displayMapping);
        }
        System.out.println();
        headerPrinted = true;
    }

    private void printProgress() {
        long total = stats.getTotalItems();
        if (total <= 0) total = 0; 
        
        long processed = stats.getProcessedItems();
        long success = stats.getSuccessItems();
        long failed = stats.getFailedItems();
        long skipped = stats.getSkippedItems();

        double percent = (total > 0) ? ((double) processed / total) * 100.0 : 0.0;
        if (percent > 100.0) percent = 100.0;

        Duration elapsed = Duration.between(startTime, Instant.now());
        double speed = (elapsed.getSeconds() > 0) ? (double) processed / elapsed.getSeconds() : 0.0;

        String etaStr = "--:--";
        if (speed > 0 && total > 0) {
            long remaining = total - processed;
            long etaSec = (long) (remaining / speed);
            etaStr = String.format("%02d:%02d:%02d", etaSec / 3600, (etaSec % 3600) / 60, etaSec % 60);
        }

        // Konsolen-Balken
        StringBuilder bar = new StringBuilder();
        int width = 30;
        int completed = (total > 0) ? (int) ((processed * width) / total) : 0;
        bar.append("[");
        for (int i = 0; i < width; i++) bar.append(i < completed ? "█" : "░");
        bar.append("]");

        // Einzeiliges Konsolen-Update mit \r
        System.out.print(String.format("\r  %s %5.1f%% | %d/%d | %.1f it/s | ETA: %s | OK: %d Fail: %d Skip: %d   ", 
            bar.toString(), percent, processed, total, speed, etaStr, success, failed, skipped));

        // Logfile-Eintrag
        logger.info(String.format("%s | %5.1f%% | %d/%d | %.1f it/s | ETA %s | ok=%d fail=%d skip=%d",
            mode, percent, processed, total, speed, etaStr, success, failed, skipped));
    }

    // --- HTML Report & Email Logic ---

    private void generateAndSendReport() {
        try {
            String reportPath = "migration_report.html";
            if (config.getProtocolOutputDir() != null) {
                new File(config.getProtocolOutputDir()).mkdirs();
                reportPath = config.getProtocolOutputDir() + File.separator + "migration_report.html";
            }
            
            String html = generateHtmlReport();
            
            // Speichern
            try (FileWriter fw = new FileWriter(reportPath)) {
                fw.write(html);
                logger.info("Report generated: " + reportPath);
            }

            // Senden
            String emailTo = config.getEmailTo();
            if (emailTo != null && !emailTo.isEmpty()) {
                logger.info("Sending report to: " + emailTo);
                // Hier würde der EmailNotifier Aufruf kommen. 
                // Da EmailNotifier static ist, rufen wir ihn direkt auf, wenn vorhanden.
                try {
                    EmailNotifier.sendReport(config, html, mode, stats);
                } catch (Exception ex) {
                    logger.error("Failed to send email: " + ex.getMessage());
                }
            }

        } catch (Exception e) {
            logger.error("Error generating report", e);
        }
    }

    private String generateHtmlReport() {
        long durationSec = Duration.between(startTime, Instant.now()).getSeconds();
        String durationStr = String.format("%02d:%02d:%02d", durationSec / 3600, (durationSec % 3600) / 60, durationSec % 60);
        
        StringBuilder sb = new StringBuilder();
        sb.append("<html><head><style>");
        sb.append("body { font-family: sans-serif; }");
        sb.append(".stat-box { background: #f4f4f4; padding: 15px; border-radius: 5px; margin-bottom: 20px; }");
        sb.append("h2 { color: #333; }");
        sb.append("</style></head><body>");
        
        sb.append("<h2>Migration Report: ").append(mode).append("</h2>");
        sb.append("<div class='stat-box'>");
        sb.append("<p><b>Source:</b> ").append(sourceSSID).append("</p>");
        sb.append("<p><b>Dest:</b> ").append(destSSID).append("</p>");
        sb.append("<p><b>Date:</b> ").append(LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME)).append("</p>");
        sb.append("<p><b>Duration:</b> ").append(durationStr).append("</p>");
        sb.append("</div>");

        sb.append("<h3>Statistics</h3>");
        sb.append("<table border='1' cellpadding='5' cellspacing='0' style='border-collapse: collapse;'>");
        sb.append("<tr><td>Total Items</td><td>").append(stats.getTotalItems()).append("</td></tr>");
        sb.append("<tr><td>Processed</td><td>").append(stats.getProcessedItems()).append("</td></tr>");
        sb.append("<tr><td style='color:green'>Success</td><td>").append(stats.getSuccessItems()).append("</td></tr>");
        sb.append("<tr><td style='color:red'>Failed</td><td>").append(stats.getFailedItems()).append("</td></tr>");
        sb.append("<tr><td style='color:orange'>Skipped</td><td>").append(stats.getSkippedItems()).append("</td></tr>");
        sb.append("</table>");
        
        sb.append("</body></html>");
        return sb.toString();
    }
}
