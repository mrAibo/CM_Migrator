package com.ibm.ecm.migration;

import com.ibm.mm.sdk.common.DKConstant;
import com.ibm.mm.sdk.common.DKDDO;
import com.ibm.mm.sdk.common.DKNVPair;
import com.ibm.mm.sdk.common.DKPidICM;
import com.ibm.mm.sdk.common.dkResultSetCursor;
import com.ibm.mm.sdk.server.DKDatastoreICM;
import java.util.regex.Pattern;
import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.apache.logging.log4j.ThreadContext;

import java.util.Map;
import java.util.concurrent.*;

/**
 * Produziert Migration-Items aus der Quell-Datenbank und legt sie in die Queue.
 * Two-pass: PASS1 zählt (für stabiles TOTAL), PASS2 enqueued (und SKIP zählt).
 */
public class Producer implements Runnable {

    private static final Logger logger = LogManager.getLogger(Producer.class);

    private static final String MODE_DELETE = "DELETE";

    private final BlockingQueue<MigrationItem> queue;
    private final MigrationConfig config;
    private final MigrationJournal journal;
    private final MigrationStats stats;
    private final int consumerCount;

    public Producer(BlockingQueue<MigrationItem> queue,
                    MigrationConfig config,
                    MigrationJournal journal,
                    MigrationStats stats) {
        this.queue = queue;
        this.config = config;
        this.journal = journal;
        this.stats = stats;
        this.consumerCount = config.getThreadCount();
    }

    private static final Pattern VALID_ITEMTYPE = Pattern.compile("^[a-zA-Z0-9_]+$");

    @Override
    public void run() {
        logger.info("Producer started (v1.30 Parallel Mode).");

        Map<String, String> mapping = config.getItemTypeMapping();
        if (mapping == null || mapping.isEmpty()) {
            logger.warn("No MIGRATEITEMTYPES configured. Producer finishing.");
            enqueuePoisonPill();
            return;
        }

        // Parallelisierung der Erkennung: ein Thread pro ItemType (begrenzt auf 10 zur Gewährleistung der Ressourcenintegrität)
        int discoveryThreads = Math.min(mapping.size(), 10);
        ExecutorService discoveryExecutor = Executors.newFixedThreadPool(discoveryThreads);

        try {
            for (Map.Entry<String, String> entry : mapping.entrySet()) {
                final String sourceType = entry.getKey();
                final String destType = entry.getValue();

                // SECURITY: Validiere ItemType Namen
                if (!VALID_ITEMTYPE.matcher(sourceType).matches() || !VALID_ITEMTYPE.matcher(destType).matches()) {
                    logger.error("SECURITY ALERT: Invalid ItemType format detected! Source='{}', Dest='{}'. Skipping.", sourceType, destType);
                    continue;
                }

                discoveryExecutor.submit(() -> {
                    ThreadContext.put("itemType", sourceType);
                    try (CMConnection localConn = new CMConnection(
                            config.getSourceSSID(),
                            config.getSourceUser(),
                            config.getSourcePassword(),
                            CMConnection.Role.SOURCE
                    )) {
                        localConn.connect();
                        processItemType(localConn, sourceType, destType);
                    } catch (Exception e) {
                        logger.error("Discovery failed for ItemType: " + sourceType, e);
                    } finally {
                        ThreadContext.remove("itemType");
                    }
                });
            }

            discoveryExecutor.shutdown();
            // Warten, bis alle Erkennungsaufgaben abgeschlossen sind
            if (!discoveryExecutor.awaitTermination(7, TimeUnit.DAYS)) {
                logger.warn("Producer discovery tasks did not finish in 7 days. Forcing shutdown.");
            }

        } catch (Exception e) {
            logger.error("Producer manager failed", e);
        } finally {
            enqueuePoisonPill();
            logger.info("Producer manager finished.");
        }
    }

    /**
     * Bisher wurde nur EINE Poison-Pill gesendet, was zu Race Conditions führen konnte
     * , bei denen mehrere Consumern um ein einziges Beendigungssignal konkurrieren.
     * Jetzt erhält jeder Consumer sein eigenes Beendigungssignal.
     */
    private void enqueuePoisonPill() {
        logger.info("Sending {} poison pills (one per consumer thread)", consumerCount);
        for (int i = 0; i < consumerCount; i++) {
            try {
                queue.put(MigrationItem.POISON_PILL);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                logger.warn("Interrupted while sending poison pill {}/{}", i + 1, consumerCount);
                break;
            }
        }
    }

    private void processItemType(CMConnection conn, String sourceType, String destType) {
        DKDatastoreICM ds = conn.getDatastore();
        logger.info("Processing ItemType - {} -> {}", sourceType, destType);

        // LEISTUNGSKRITISCH: Alle vorhandenen Einträge VOR der Cursor-Schleife in den Cache vorladen.
        int preloadedCount = journal.preloadCache(sourceType);
        logger.info("Cache preloaded with existing entries for {}: {}", sourceType, preloadedCount);

        final String query = buildQuery(sourceType);
        logger.info("CM Query for {}: {}", sourceType, query);

        // Optionen wie in deinem Code-Stil
        final DKNVPair[] options = new DKNVPair[] {
                new DKNVPair("MAXRESULTS", 0),
                new DKNVPair("FETCHSIZE", 1000),
                new DKNVPair("End", null)
        };

        // ---------------------------------------------------------
        // PASS 1: Zählen (TOTAL)
        // ---------------------------------------------------------
        String strategy = config.getProducerCountStrategy();
        long totalMatched = -1;
        boolean triedSQL = false;
        
        // Strategy: COUNT_SQL or HYBRID
        if (!"SDK_CURSOR".equals(strategy) && config.getFilterPredicate().isEmpty()) {
            triedSQL = true;
            try {
                java.sql.Connection sqlConn = conn.getJDBCConnection();
                if (sqlConn != null) {
                    String tableName = conn.getMSTTableName(sourceType);
                    totalMatched = countItemsWithNativeSQL(ds, sqlConn, sourceType, tableName);
                    if (totalMatched >= 0) {
                        logger.info("NATIVE SQL PASS1 matched for {}: {} (Strategy={})", sourceType, totalMatched, strategy);
                    }
                }
            } catch (Exception e) {
                logger.debug("Native SQL count attempt failed: {}", e.getMessage());
            }
        }

        // Strategy: SDK_CURSOR or HYBRID-Fallback or COUNT_SQL-Failure
        if (totalMatched < 0) {
            if ("COUNT_SQL".equals(strategy) && triedSQL) {
                logger.warn("Native SQL count failed and strategy is COUNT_SQL. Setting total to 0.");
                totalMatched = 0;
            } else {
                // FALLBACK or Explicit SDK_CURSOR
                logger.info("Using SDK-based PASS1 count for {} (Strategy={})", sourceType, strategy);
                dkResultSetCursor cursor1 = null;
                totalMatched = 0;
                try {
                    cursor1 = ds.execute(query, DKConstant.DK_CM_XQPE_QL_TYPE, options);
                    while (true) {
                        DKDDO item = cursor1.fetchNext();
                        if (item == null) break;
                        totalMatched++;
                    }
                    logger.info("SDK PASS1 matched for {}: {}", sourceType, totalMatched);
                } catch (Exception e) {
                    logger.warn("PASS1 count failed for ItemType {} (query={}).", sourceType, query, e);
                    totalMatched = 0;
                } finally {
                    if (cursor1 != null) {
                        try { cursor1.close(); } catch (Exception ignore) {}
                        try { cursor1.destroy(); } catch (Exception ignore) {}
                    }
                }
            }
        }

        // Jetzt kennt der Monitor ein stabiles TOTAL
        stats.addTotalItems(totalMatched);

        // -------------------------
        // PASS 2: Enqueue / Skip
        // -------------------------
        dkResultSetCursor cursor2 = null;
        long fetched = 0;
        long enqueued = 0;
        long skipped = 0;

        long totalFetchMs = 0;
        long lastDiagLog = System.currentTimeMillis();

        try {
            cursor2 = ds.execute(query, DKConstant.DK_CM_XQPE_QL_TYPE, options);

            while (true) {
                long fetchStart = System.currentTimeMillis();
                DKDDO item = cursor2.fetchNext();
                long fetchMs = System.currentTimeMillis() - fetchStart;

                totalFetchMs += fetchMs;

                if (item == null) break;

                fetched++;

                DKPidICM pid = (DKPidICM) item.getPidObject();
                String fullPidString = pid.pidString();

                boolean isDeleteMode = MODE_DELETE.equalsIgnoreCase(config.getOperationMode());

                boolean alreadyProcessed = isDeleteMode
                        ? journal.isDeleted(fullPidString, sourceType)
                        : journal.isMigrated(fullPidString, sourceType);

                if (alreadyProcessed) {
                    // Verhalten wie vorher: Skips zählen in Stats (inkl. processed++ über incrementSkipped()).
                    stats.incrementSkipped();
                    skipped++;
                } else {
                    queue.put(new MigrationItem(fullPidString, sourceType, destType));
                    enqueued++;
                }

                // v1.28: Sparse/Batch Logging for 500M+ scenarios
                if (config.isLogItemsBatched()) {
                    int interval = config.getLogBatchInterval();
                    if (fetched % interval == 0) {
                        logger.info("PRODUCER BATCH Type={} Count={} QueueDepth={}", sourceType, fetched, queue.size());
                    }
                } else {
                    // DIAGNOSTIK: alle 30 Sekunden (Legacy mode)
                    long now = System.currentTimeMillis();
                    if (now - lastDiagLog > 30000) {
                        lastDiagLog = now;
                        long avgFetch = fetched > 0 ? (totalFetchMs / fetched) : 0;
                        logger.info("PRODUCER STATS Type={} Fetched={} Enqueued={} Skipped={} AvgFetchMs={} QueueDepth={}",
                                sourceType, fetched, enqueued, skipped, avgFetch, queue.size());
                    }
                }
            }

            long avgFetch = fetched > 0 ? (totalFetchMs / fetched) : 0;
            logger.info("PASS2 COMPLETE Type={} Fetched={} Enqueued={} Skipped={} AvgFetchMs={}",
                    sourceType, fetched, enqueued, skipped, avgFetch);

        } catch (Exception e) {
            logger.error("PASS2 enqueue failed for ItemType {} (query={})", sourceType, query, e);
            throw new RuntimeException("PASS2 enqueue failed for " + sourceType, e);
        } finally {
            if (cursor2 != null) {
                try { cursor2.close(); } catch (Exception ignore) {}
                try { cursor2.destroy(); } catch (Exception ignore) {}
            }
        }
    }

    /**
     * Führt eine schnelle native SQL-Zählung in der Tabelle „ItemType“ durch
     * Dadurch wird vermieden, dass alle DKDDO-Objekte nur zum Zählen abgerufen werden müssen
     */
    private long countItemsWithNativeSQL(DKDatastoreICM ds, java.sql.Connection conn, String sourceType, String tableName) {
        String sql = "SELECT COUNT(*) FROM " + tableName + " " +
                     "WHERE ITEMTYPEID = (SELECT ITEMTYPEID FROM ICMSTITEMTYPEDEFS WHERE ITEMTYPENAME = ?)";

        try (java.sql.PreparedStatement pstmt = conn.prepareStatement(sql)) {
            pstmt.setString(1, sourceType);
            try (java.sql.ResultSet rs = pstmt.executeQuery()) {
                if (rs.next()) {
                    return rs.getLong(1);
                }
            }
        } catch (Exception e) {
            // Fallback to EntityDef name if ITEMTYPENAME fails (some older schemas use NAME)
            String fallbackSql = "SELECT COUNT(*) FROM " + tableName + " " +
                                 "WHERE ITEMTYPEID = (SELECT ITEMTYPEID FROM ICMSTITEMTYPEDEFS WHERE NAME = ?)";
            try (java.sql.PreparedStatement pstmt = conn.prepareStatement(fallbackSql)) {
                pstmt.setString(1, sourceType);
                try (java.sql.ResultSet rs = pstmt.executeQuery()) {
                    if (rs.next()) return rs.getLong(1);
                }
            } catch (Exception e2) {
                logger.debug("Fast SQL count failed: {} / {}", e.getMessage(), e2.getMessage());
            }
        }
        return -1;
    }

    /**
     * Baut eine robuste Query aus sourceType + optionalem FILTERPREDICATE.
     *
     * Regeln:
     * - Default: "/<ItemType>"
     * - Wenn FILTERPREDICATE mit "/" oder "//" oder "(" startet => als komplette Query verwenden.
     * - Sonst als Predicate an "/<ItemType>" hängen (und in [...] kapseln, falls nötig).
     */
    private String buildQuery(String sourceType) {
        String predicate = config.getFilterPredicate();
        if (predicate == null) predicate = "";
        predicate = predicate.trim();

        String root = "/" + sourceType;

        if (predicate.isEmpty()) {
            return root;
        }

        // User liefert komplette Query
        if (predicate.startsWith("/") || predicate.startsWith("//") || predicate.startsWith("(")) {
            return predicate;
        }

        // User liefert nur Bedingungen -> in [ ... ] packen und an Root hängen
        String p = predicate;

        if (!p.startsWith("[")) p = "[" + p;
        if (!p.endsWith("]"))  p = p + "]";

        // Hinweis/Warnung: "//" ohne Kontext ist oft problematisch
        if (p.contains("//") && !p.contains(".//")) {
            logger.warn("FILTERPREDICATE contains '//' without './/' (predicate='{}'). If queries fail, try using './/' for relative paths.", predicate);
        }

        return root + p;
    }
}
